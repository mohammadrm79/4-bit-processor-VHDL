#!/usr/bin/awk -f

###############################################################################
# RISC-4 Assembler
###############################################################################

BEGIN {

    FS="[ ,\t]+"
    OFS=""

    ###########################################################################
    # Opcodes
    ###########################################################################

    opcode["ADD"]   = 0
    opcode["SUB"]   = 1
    opcode["INC"]   = 2
    opcode["DEC"]   = 3

    opcode["AND"]   = 4
    opcode["OR"]    = 5
    opcode["XOR"]   = 6
    opcode["NOT"]   = 7

    opcode["SHL"]   = 8
    opcode["SHR"]   = 9

    opcode["LOAD"]  = 10
    opcode["STORE"] = 11

    opcode["MOVI"]  = 12

    opcode["JMP"]   = 13
    opcode["JZ"]    = 14
    opcode["JC"]    = 15

    opcode["NOP"]   = 16
    opcode["HALT"]  = 17

    ###########################################################################
    # Register table
    ###########################################################################

    reg["R0"]=0
    reg["R1"]=1
    reg["R2"]=2
    reg["R3"]=3
    reg["R4"]=4
    reg["R5"]=5
    reg["R6"]=6
    reg["R7"]=7

    pc = 0
}

###############################################################################
# Utility
###############################################################################

function trim(s)
{
    gsub(/^[ \t]+/, "", s)
    gsub(/[ \t]+$/, "", s)
    return s
}

function hex4(v)
{
    return sprintf("%04X", and(v,65535))
}

###############################################################################
# Ignore
###############################################################################

/^[ \t]*$/ { next }

/^[ \t]*;/ { next }

###############################################################################
# Labels
###############################################################################

/:$/ {

    label = $1
    sub(":","",label)

    labels[label] = pc

    next
}

###############################################################################
# Parse instruction
###############################################################################

{

    inst = toupper($1)

    ###########################################################################
    # MOVI
    #
    # MOVI R0,5
    ###########################################################################

    if(inst=="MOVI")
    {
        rd = reg[toupper($2)]
        imm = $3 + 0

        word =\
            opcode[inst] * 2048 +\
            rd           * 256  +\
            imm

        code[pc++] = word

        next
    }

    ###########################################################################
    # ADD/SUB/AND/OR/XOR
    #
    # ADD R0,R1,R2
    ###########################################################################

    if(inst=="ADD" ||
       inst=="SUB" ||
       inst=="AND" ||
       inst=="OR"  ||
       inst=="XOR")
    {
        rd  = reg[toupper($2)]
        rs1 = reg[toupper($3)]
        rs2 = reg[toupper($4)]

        word = \
            opcode[inst] * 2048 +\
            rd           * 256  +\
            rs1          * 32   +\
            rs2          * 4

        code[pc++] = word

        next
    }

    ###########################################################################
    # INC DEC NOT SHL SHR
    #
    # INC R0,R1
    ###########################################################################

    if(inst=="INC" ||
       inst=="DEC" ||
       inst=="NOT" ||
       inst=="SHL" ||
       inst=="SHR")
    {
        rd  = reg[toupper($2)]
        rs1 = reg[toupper($3)]

        word =\
            opcode[inst] * 2048 +\
            rd           * 256  +\
            rs1          * 32

        code[pc++] = word

        next
    }
        ###########################################################################
    # LOAD
    #
    # LOAD R0,15
    ###########################################################################

    if(inst=="LOAD")
    {
        rd   = reg[toupper($2)]
        addr = $3 + 0

        word =\
            opcode[inst] * 2048 +\
            rd           * 256  +\
            addr

        code[pc++] = word

        next
    }

    ###########################################################################
    # STORE
    #
    # STORE R0,15
    ###########################################################################

    if(inst=="STORE")
    {
        rs   = reg[toupper($2)]
        addr = $3 + 0

        word =\
            opcode[inst] * 2048 +\
            rs           * 256  +\
            addr

        code[pc++] = word

        next
    }

    ###########################################################################
    # JMP / JZ / JC
    #
    # JMP LOOP
    # JZ END
    ###########################################################################

    if(inst=="JMP" ||
       inst=="JZ"  ||
       inst=="JC")
    {
        jump_target[pc] = $2
        jump_opcode[pc] = opcode[inst]

        code[pc] = -1

        pc++

        next
    }

    ###########################################################################
    # NOP
    ###########################################################################

    if(inst=="NOP")
    {
        word = opcode["NOP"] * 2048

        code[pc++] = word

        next
    }

    ###########################################################################
    # HALT
    ###########################################################################

    if(inst=="HALT")
    {
        word = opcode["HALT"] * 2048

        code[pc++] = word

        next
    }

    ###########################################################################
    # Unknown instruction
    ###########################################################################

    print "Assembler error: Unknown instruction:", inst > "/dev/stderr"

    exit 1
}

###############################################################################
# Second pass
###############################################################################

END {

    for(i=0;i<pc;i++)
    {
        if(code[i] != -1)
            continue

        label = jump_target[i]

        if(!(label in labels))
        {
            print "Undefined label:", label > "/dev/stderr"
            exit 1
        }

        addr = labels[label]

        code[i] =\
            jump_opcode[i] * 2048 +\
            addr
    }

###############################################################################
# Write .mem
###############################################################################

    for(i=0;i<pc;i++)
        print hex4(code[i])
}